# ============================================
# PlayBeat Digital Backend Environment
# ============================================

# Server
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Redis (Upstash recommended for serverless)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets (generate strong random strings)
JWT_SECRET=playbeat-super-secret-jwt-key-change-in-production-min-32-chars
JWT_REFRESH_SECRET=playbeat-refresh-secret-key-change-in-production-min-32-chars

# 2FA
TWO_FACTOR_ISSUER=PlayBeat Digital

# Encryption
ENCRYPTION_KEY=your-32-char-encryption-key-here!!

# Payment Gateways
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

PAYPAL_CLIENT_ID=...
PAYPAL_CLIENT_SECRET=...
PAYPAL_WEBHOOK_ID=...

COINBASE_API_KEY=...
COINBASE_WEBHOOK_SECRET=...

# Email (SendGrid recommended)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=SG.xxxxx
SMTP_FROM=noreply@playbeat.digital
SMTP_FROM_NAME=PlayBeat Digital

# Cloud Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=...
CLOUDINARY_API_KEY=...
CLOUDINARY_API_SECRET=...

# OAuth
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
GITHUB_CLIENT_ID=...
GITHUB_CLIENT_SECRET=...
FACEBOOK_APP_ID=...
FACEBOOK_APP_SECRET=...

# Notifications
TWILIO_ACCOUNT_SID=...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1234567890

FIREBASE_PROJECT_ID=...
FIREBASE_PRIVATE_KEY=...
FIREBASE_CLIENT_EMAIL=...

TELEGRAM_BOT_TOKEN=...

# Monitoring
SENTRY_DSN=https://...@sentry.io/...
